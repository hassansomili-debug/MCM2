# Local server
MCM_ENV=development
MCM_HOST=127.0.0.1
PORT=8000
MCM_DB_PATH=./mcm.sqlite3
MCM_ALLOWED_ORIGIN=same-origin
MCM_SESSION_TTL=28800
MCM_INVITATION_TTL=604800
MCM_RESET_TTL=1800
MCM_MAX_DOCX_BYTES=8388608

# Configure the one platform-manager account through secrets, never source code.
MCM_ADMIN_NAME=مدير المنصة
MCM_ADMIN_EMAIL=hmsomili@gmail.com
MCM_ADMIN_PASSWORD=replace-with-a-long-random-secret
MCM_ALLOW_REGISTRATION=0

# Diagnostics only. Keep disabled in production.
MCM_ACCESS_LOG=0
MCM_DEBUG=0
MCM_EXPOSE_DEV_RESET_TOKEN=0

# Optional improvement-plan enhancement. Keep off until a server-side key is
# configured. Scores and maturity classification never depend on this service.
MCM_AI_PROVIDER=off
# MCM_AI_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=replace-with-server-secret
# GEMINI_API_KEY=replace-with-server-secret
# MCM_AI_BASE_URL=http://127.0.0.1:11434/v1
# MCM_AI_TIMEOUT=15
