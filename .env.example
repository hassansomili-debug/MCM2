# Local server
MCM_ENV=development
MCM_HOST=127.0.0.1
PORT=8000
MCM_DB_PATH=./mcm.sqlite3
MCM_ALLOWED_ORIGIN=same-origin
MCM_SESSION_TTL=28800
MCM_INVITATION_TTL=604800
MCM_RESET_TTL=1800
MCM_MAX_DOCX_BYTES=8388608

# Replace every bootstrap credential outside a private developer machine.
MCM_ADMIN_EMAIL=admin@example.com
MCM_ADMIN_PASSWORD=replace-with-a-long-random-secret
MCM_DEMO_EMAIL=demo@example.com
MCM_DEMO_PASSWORD=replace-with-a-long-random-secret
MCM_SEED_DEMO=1
MCM_PUBLIC_DEMO=1
MCM_ALLOW_REGISTRATION=1

# Diagnostics only. Keep disabled in production.
MCM_ACCESS_LOG=0
MCM_DEBUG=0
MCM_EXPOSE_DEV_RESET_TOKEN=0
